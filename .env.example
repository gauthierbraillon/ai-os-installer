# AI OS Installer - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!

# AI API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Alternative: OpenAI (if Claude not available)
# OPENAI_API_KEY=sk-...

# Log level (optional)
LOG_LEVEL=INFO

# VM settings (optional)
VM_MEMORY_MB=2048
VM_DISK_GB=20
